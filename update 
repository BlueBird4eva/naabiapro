}

.status.offline {
  background: rgba(248, 113, 113, 0.12);
  color: var(--danger);
}

.layout {
  display: grid;
  grid-template-columns: repeat(12, minmax(0, 1fr));
  gap: 24px;
}

.panel {
  background: var(--panel);
  border: 1px solid rgba(148, 163, 184, 0.14);
  border-radius: 24px;
  box-shadow: var(--shadow);
  padding: 22px;
  position: relative;
  overflow: hidden;
  animation: riseIn 0.7s ease both;
}

.glass-panel::before {
  content: "";
  position: absolute;
  inset: 0;
  background: linear-gradient(135deg, rgba(125, 211, 252, 0.06), transparent 40%, rgba(34, 197, 94, 0.05));
  pointer-events: none;
}

.auth-panel {
  grid-column: span 4;
}

.route-panel {
  grid-column: span 8;
}

.data-panel {
  grid-column: 1 / -1;
}

.panel-kicker {
  font-size: 0.7rem;
  letter-spacing: 0.14em;
  text-transform: uppercase;
  color: var(--primary-soft);
  margin-bottom: 8px;
  font-weight: 800;
}

.panel-header,
.section-title-wrap {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
  margin-bottom: 18px;
  position: relative;
  z-index: 1;
}

.panel-copy {
  color: var(--muted);
  line-height: 1.7;
  max-width: 34ch;
  position: relative;
  z-index: 1;
}

.auth-form {
  display: grid;
  gap: 16px;
  margin-top: 18px;
  position: relative;
  z-index: 1;
}

.auth-form label,
.swap-wrap label {
  display: grid;
  gap: 8px;
  color: var(--text);
  font-weight: 600;
}

input,
select {
  width: 100%;
  border: 1px solid rgba(148, 163, 184, 0.22);
  border-radius: 12px;
  background: rgba(255, 255, 255, 0.04);
  padding: 12px 14px;
  color: var(--text);
  transition: border-color 0.22s ease, box-shadow 0.22s ease, transform 0.22s ease;
}

input::placeholder {
  color: var(--muted);
}

input:focus,
select:focus {
  outline: none;
  border-color: var(--primary-soft);
  box-shadow: 0 0 0 4px rgba(125, 211, 252, 0.12);
}

.primary-btn,
.secondary-btn,
.mode-btn,
.swap-btn,
.voice-btn {
  border: 0;
  cursor: pointer;
  transition: transform 0.22s ease, box-shadow 0.22s ease, opacity 0.22s ease;
}

.primary-btn {
  background: linear-gradient(135deg, #0ea5e9, #2563eb);
  color: #fff;
  border-radius: 12px;
  font-weight: 700;
  padding: 12px 18px;
  box-shadow: 0 12px 22px rgba(14, 165, 233, 0.26);
}

.secondary-btn {
  background: rgba(125, 211, 252, 0.12);
  color: var(--primary);
  border-radius: 12px;
  font-weight: 700;
  padding: 12px 18px;
  border: 1px solid rgba(125, 211, 252, 0.18);
}

.voice-btn {
  background: linear-gradient(135deg, rgba(34, 197, 94, 0.9), rgba(14, 165, 233, 0.9));
  color: white;
  border-radius: 12px;
  padding: 12px 18px;
  font-weight: 700;
  box-shadow: 0 14px 24px rgba(34, 197, 94, 0.2);
}

.primary-btn:hover,
.secondary-btn:hover,
.mode-btn:hover,
.swap-btn:hover,
.voice-btn:hover,
.icon-btn:hover {
  transform: translateY(-1px) scale(1.01);
  box-shadow: 0 10px 18px rgba(15, 23, 42, 0.15);
}

.route-actions {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 12px;
  margin-top: 18px;
  position: relative;
  z-index: 1;
}

.wide {
  width: 100%;
}

.auth-state {
  margin-top: 16px;
  background: rgba(34, 197, 94, 0.12);
  color: #86efac;
  border-radius: 12px;
  padding: 12px 14px;
  line-height: 1.5;
  border: 1px solid rgba(34, 197, 94, 0.18);
  position: relative;
  z-index: 1;
}

.auth-state.error {
  background: rgba(248, 113, 113, 0.1);
  color: #fca5a5;
  border-color: rgba(248, 113, 113, 0.2);
}

.hidden {
  display: none !important;
}

.trip-mode {
  display: inline-flex;
  background: rgba(125, 211, 252, 0.08);
  border-radius: 999px;
  padding: 6px;
  border: 1px solid rgba(125, 211, 252, 0.14);
}

.mode-btn {
  background: transparent;
  color: var(--primary);
  border-radius: 999px;
  padding: 9px 14px;
  font-weight: 700;
  border: none;
}

.mode-btn.active {
  background: linear-gradient(135deg, rgba(125, 211, 252, 0.18), rgba(34, 197, 94, 0.12));
  box-shadow: inset 0 0 0 1px rgba(125, 211, 252, 0.2);
}

.swap-wrap {
  display: grid;
  grid-template-columns: 1fr auto 1fr;
  align-items: end;
  gap: 16px;
  position: relative;
  z-index: 1;
}

.swap-btn {
  width: 48px;
  height: 48px;
  border-radius: 50%;
  font-size: 1.4rem;
  background: rgba(125, 211, 252, 0.12);
  color: var(--primary);
  margin-bottom: 8px;
  border: 1px solid rgba(125, 211, 252, 0.2);
}

.voice-panel {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
  margin-top: 18px;
  background: rgba(255, 255, 255, 0.03);
  border: 1px solid rgba(148, 163, 184, 0.13);
  border-radius: 12px;
  padding: 10px 12px;
  position: relative;
  z-index: 1;
}

.voice-status {
  color: var(--muted);
  font-size: 0.82rem;
}

.price-output {
  margin-top: 20px;
  min-height: 88px;
  position: relative;
  z-index: 1;
}

.fare-card {
  background: linear-gradient(135deg, rgba(34, 197, 94, 0.12), rgba(14, 165, 233, 0.1));
  border: 1px solid rgba(34, 197, 94, 0.2);
  border-radius: 18px;
  padding: 18px;
}

.fare-label {
  display: block;
  font-size: 0.8rem;
  text-transform: uppercase;
  letter-spacing: 0.08em;
  color: var(--muted);
  margin-bottom: 10px;
}

.fare-card strong {
  display: block;
  font-size: clamp(1.8rem, 3vw, 2.7rem);
  color: var(--primary);
  margin-bottom: 8px;
}

.fare-card p {
  margin: 0;
  line-height: 1.6;
  color: var(--text);
}

.route-history-wrap {
  margin-top: 22px;
  position: relative;
  z-index: 1;
}

.route-history-wrap h3 {
  margin-bottom: 12px;
  color: var(--primary);
}

.route-history {
  display: grid;
  gap: 12px;
}

.history-item {
  display: grid;
  grid-template-columns: 1fr auto 1fr auto;
  align-items: center;
  gap: 8px;
  background: rgba(255, 255, 255, 0.025);
  border: 1px solid rgba(148, 163, 184, 0.15);
  border-radius: 12px;
  padding: 10px 12px;
  font-size: 0.94rem;
}

.history-item strong {
  color: var(--primary-soft);
}

.empty-state {
  color: var(--muted);
  margin: 0;
}

.search-box-wrap {
  width: min(260px, 100%);
}

.badge {
  background: var(--chip-bg);
  color: var(--primary-soft);
  border-radius: 999px;
  padding: 8px 12px;
  font-size: 0.75rem;
  font-weight: 700;
  border: 1px solid rgba(125, 211, 252, 0.12);
}

.route-card-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
  gap: 16px;
  margin-bottom: 20px;
  position: relative;
  z-index: 1;
}

.route-card {
  background: linear-gradient(135deg, rgba(125, 211, 252, 0.08), rgba(34, 197, 94, 0.08));
  border: 1px solid rgba(148, 163, 184, 0.15);
  border-radius: 18px;
  padding: 16px;
  box-shadow: 0 12px 24px rgba(15, 23, 42, 0.08);
}

.route-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 8px;
  margin-bottom: 12px;
}

.route-header strong {
  color: var(--primary);
  font-size: 1.2rem;
}

.chip {
  background: rgba(251, 191, 36, 0.12);
  color: var(--gold);
  border-radius: 999px;
  padding: 6px 8px;
  font-size: 0.7rem;
  font-weight: 700;
}

.route-card p {
  margin: 0;
  line-height: 1.5;
  color: var(--text);
}

.route-arrow {
  text-align: center;
  color: var(--primary-soft);
  font-size: 1.2rem;
  font-weight: 700;
}

.route-card small {
  display: block;
  margin-top: 10px;
  color: var(--muted);
}

.lga-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
  gap: 16px;
  position: relative;
  z-index: 1;
}

.lga-card {
  background: rgba(255, 255, 255, 0.03);
  border: 1px solid rgba(148, 163, 184, 0.15);
  border-radius: 16px;
  padding: 16px;
  transition: transform 0.22s ease, border-color 0.22s ease;
}

.lga-card h3 {
  margin-bottom: 12px;
  color: var(--primary);
}

.lga-card ul {
  margin: 0;
  padding-left: 18px;
  display: grid;
  gap: 8px;
  color: var(--text);
}

.reveal-card {
  animation: riseIn 0.6s ease both;
  transform-origin: center;
}

@keyframes riseIn {
  from {
    opacity: 0;
    transform: translateY(14px) scale(0.985);
  }
  to {
    opacity: 1;
    transform: translateY(0) scale(1);
  }
}

@keyframes floaty {
  0%, 100% {
    transform: translateY(0px);
  }
  50% {
    transform: translateY(-6px);
  }
}

@media (max-width: 780px) {
  .auth-panel,
  .route-panel {
    grid-column: 1 / -1;
  }

  .swap-wrap {
    grid-template-columns: 1fr;
  }

  .route-actions {
    grid-template-columns: 1fr;
  }

  .voice-panel {
    flex-direction: column;
    align-items: flex-start;
  }

  .swap-btn {
    width: 100%;
    border-radius: 12px;
    margin-bottom: 0;
  }

  .topbar,
  .panel-header,
  .section-title-wrap {
    flex-direction: column;
    align-items: flex-start;
  }

  .search-box-wrap {
    width: 100%;
  }
}
EOF

