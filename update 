          <button id="logoutBtn" class="secondary-btn hidden" type="button">Sign out</button>
        </section>

        <section class="panel route-panel glass-panel">
          <div class="panel-header">
            <div>
              <div class="panel-kicker">Travel fare</div>
              <h2>Abia State trip price</h2>
            </div>

            <div class="trip-mode" aria-label="Trip mode selector">
              <button class="mode-btn active" type="button" data-mode="within">Within Abia</button>
