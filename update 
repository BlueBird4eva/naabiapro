const STORAGE_KEY = "naabiaProUser";
const ROUTE_HISTORY_KEY = "naabiaRouteHistory";
const THEME_KEY = "naabiaTheme";

const LGA_ROUTE_DATA = [
  {
    lga: "Aba North",
    stops: ["Aba Main Park", "Uratta Bus Stop", "Ogbor Hill Terminal", "Aba Clinic Junction", "Eziukwu Road Stop"]
  },
  {
    lga: "Aba South",
    stops: ["Aba Express Terminal", "St. Michael Road Stop", "Eziukwu Terminal", "Aba River Road Stop", "Obohia Junction"]
  },
  {
    lga: "Arochukwu",
    stops: ["Arochukwu Motor Park", "Ohafia Road Junction", "Isuochi Terminal", "Ndi Okegbu Stop", "Arochukwu Market Stop"]
  },
  {
    lga: "Bende",
    stops: ["Bende Motor Park", "Item Road Stop", "Ekwe Terminal", "Ameki Junction", "Bende Market Stop"]
  },
  {
    lga: "Ikwuano",
    stops: ["Ikwuano Park", "Ubakala Bus Stop", "Olokoro Terminal", "Bende Road Stop", "Amawom Junction"]
  },
  {
    lga: "Isiala Ngwa North",
    stops: ["Isiala Ngwa North Terminal", "Naze Junction", "Okpuala Ngwa Stop", "Aba Road Park", "Nsulu Road Stop"]
  },
  {
    lga: "Isiala Ngwa South",
    stops: ["Isiala Ngwa South Park", "Ngwa Road Stop", "Mgboko Terminal", "Umuahia Road Stop", "Ahiaba Stop"]
  },
  {
    lga: "Isuikwuato",
    stops: ["Isuikwuato Motor Park", "Lokpanta Bus Stop", "Arochukwu Road Junction", "Amuda Terminal", "Ohafia Junction Stop"]
  },
  {
    lga: "Obi Ngwa",
    stops: ["Obi Ngwa Motor Park", "Aba-Umuahia Link Stop", "Mgboko Junction", "Ikot Ekpene Road Stop", "Obi Ngwa Market Stop"]
  },
  {
    lga: "Ohafia",
    stops: ["Ohafia Terminal", "Arochukwu Road Park", "Abiriba Junction", "Isi Uzo Road Stop", "Nkporo Stop"]
  },
  {
    lga: "Osisioma",
    stops: ["Osisioma Motor Park", "Aba-Owerri Link Stop", "Nnewi Road Junction", "Mgboko Bus Stop", "Osisioma Market Stop"]
  },
  {
    lga: "Ugwunagbo",
    stops: ["Ugwunagbo Terminal", "Aba Urban Link", "Mgboko Park", "Ovom Junction", "Ugwunagbo Market Stop"]
  },
  {
    lga: "Ukwa East",
    stops: ["Ukwa East Terminal", "Okezie Road Park", "Opobo Road Stop", "Aba-Port Harcourt Link", "Asa Stop"]
  },
  {
    lga: "Ukwa West",
    stops: ["Ukwa West Motor Park", "Aba Calabar Link", "Okirika Road Stop", "Akwete Bus Stop", "West Ukwa Market"]
  },
  {
    lga: "Umuahia North",
    stops: ["Umuahia Main Park", "Bende Road Terminal", "Ahiaeke Market Stop", "Old Umuahia Park", "Ubani Road Stop"]
  },
  {
    lga: "Umuahia South",
    stops: ["Umuahia South Terminal", "Mbakwu Junction", "Nigeria Correctional Stop", "Okpara Avenue Stop", "Aba Road Terminal"]
  },
  {
    lga: "Umu Nneochi",
    stops: ["Umu Nneochi Motor Park", "Isuochi Junction", "Arochukwu Link Stop", "Nneochi Market Stop", "Lodging Road Bus Stop"]
  }
];

const popularRoutes = [
  { from: "Aba Main Park", to: "Umuahia Main Park", fare: 1200, note: "High-traffic city route" },
  { from: "Umuahia Main Park", to: "Aba Express Terminal", fare: 1450, note: "Popular inter-city corridor" },
  { from: "Arochukwu Motor Park", to: "Ohafia Terminal", fare: 850, note: "Short regional route" },
  { from: "Bende Motor Park", to: "Aba Main Park", fare: 1600, note: "Cross-LGA commuter route" }
];

const allStops = LGA_ROUTE_DATA.flatMap((entry) =>
  entry.stops.map((stop) => ({
    stop,
    lga: entry.lga
  }))
);

const state = {
  mode: "within",
  theme: "dark"
};

const stopToLga = Object.fromEntries(allStops.map((entry) => [entry.stop, entry.lga]));
const lgaOrder = LGA_ROUTE_DATA.map((entry) => entry.lga);

const fromStopSelect = document.getElementById("fromStop");
const toStopSelect = document.getElementById("toStop");
const lgaStopsContainer = document.getElementById("lgaStops");
const priceOutput = document.getElementById("priceOutput");
const connectionStatus = document.getElementById("connectionStatus");
const signInForm = document.getElementById("signInForm");
const authState = document.getElementById("authState");
const logoutBtn = document.getElementById("logoutBtn");
const routeHistory = document.getElementById("routeHistory");
const lgaSearchInput = document.getElementById("lgaSearch");
const popularRoutesContainer = document.getElementById("popularRoutes");
const themeToggle = document.getElementById("themeToggle");
const playIgboVoiceBtn = document.getElementById("playIgboVoiceBtn");
const voiceStatus = document.getElementById("voiceStatus");
const modeButtons = document.querySelectorAll(".mode-btn");

function populateStops() {
  const options = allStops
    .map((entry) => `<option value="${entry.stop}">${entry.stop} (${entry.lga})</option>`)
    .join("");

  fromStopSelect.innerHTML = options;
  toStopSelect.innerHTML = options;

  fromStopSelect.selectedIndex = 0;
  toStopSelect.selectedIndex = 1 < allStops.length ? 1 : 0;
  if (fromStopSelect.value === toStopSelect.value) {
    toStopSelect.selectedIndex = (fromStopSelect.selectedIndex + 1) % allStops.length;
  }
}

function renderPopularRoutes() {
  popularRoutesContainer.innerHTML = popularRoutes
    .map(
      (route) => `
        <article class="route-card reveal-card">
          <div class="route-header">
            <span class="chip">Popular</span>
            <strong>₦${Number(route.fare).toLocaleString()}</strong>
          </div>
          <p>${route.from}</p>
          <p class="route-arrow">→</p>
          <p>${route.to}</p>
          <small>${route.note}</small>
        </article>
      `
    )
    .join("");
}

function renderLgaStops(filter = "") {
  const normalized = filter.trim().toLowerCase();
  const filtered = LGA_ROUTE_DATA.filter((entry) => {
    if (!normalized) return true;
    const text = `${entry.lga} ${entry.stops.join(" ")}`.toLowerCase();
    return text.includes(normalized);
  });

  lgaStopsContainer.innerHTML = filtered
    .map(
      (entry) => `
        <article class="lga-card reveal-card">
          <h3>${entry.lga}</h3>
          <ul>
            ${entry.stops.map((stop) => `<li>${stop}</li>`).join("")}
          </ul>
        </article>
      `
    )
    .join("");
}

function updateConnectionStatus() {
  const isOnline = navigator.onLine;
  connectionStatus.textContent = isOnline ? "Online" : "Offline";
  connectionStatus.classList.toggle("online", isOnline);
  connectionStatus.classList.toggle("offline", !isOnline);
}

function setAuthMessage(message, isError = false) {
  authState.textContent = message;
  authState.classList.toggle("error", isError);
  authState.classList.remove("hidden");
}

function renderAuthState() {
  const user = JSON.parse(localStorage.getItem(STORAGE_KEY) || "null");

  if (!user) {
    signInForm.classList.remove("hidden");
    logoutBtn.classList.add("hidden");
    authState.classList.add("hidden");
    return;
  }

  signInForm.classList.add("hidden");
  logoutBtn.classList.remove("hidden");
  authState.classList.remove("hidden");
  authState.innerHTML = `
    <strong>Signed in as: ${user.name}</strong><br />
    <span>${user.phone}</span><br />
    <small>${navigator.onLine ? "Online sync available" : "Offline access active"}</small>
  `;
}

function getRouteHistory() {
  try {
    return JSON.parse(localStorage.getItem(ROUTE_HISTORY_KEY) || "[]");
  } catch {
    return [];
  }
}

function saveRouteHistory(history) {
  localStorage.setItem(ROUTE_HISTORY_KEY, JSON.stringify(history));
}

function renderHistory() {
  const history = getRouteHistory();

  if (!history.length) {
    routeHistory.innerHTML = '<p class="empty-state">No saved routes yet.</p>';
    return;
  }

  routeHistory.innerHTML = history
    .slice(0, 5)
    .map(
      (item) => `
        <div class="history-item">
          <span>${item.from}</span>
          <span>→</span>
          <span>${item.to}</span>
          <strong>₦${Number(item.fare).toLocaleString()}</strong>
        </div>
      `
    )
    .join("");
}

function estimateFare(fromStop, toStop) {
  if (!fromStop || !toStop || fromStop === toStop) {
    return { fare: null, note: "Choose two different stops to see the fare." };
  }

  const fromLga = stopToLga[fromStop];
  const toLga = stopToLga[toStop];
  const fromIndex = lgaOrder.indexOf(fromLga);
  const toIndex = lgaOrder.indexOf(toLga);
  const gap = Math.abs(fromIndex - toIndex);

  let fare = 650;
  let note = `Trip from ${fromStop} to ${toStop} within Abia State.`;

  if (state.mode === "interstate") {
    fare = 2200 + Math.floor(Math.random() * 1800);
    note = `Inter-state route from ${fromStop} to ${toStop}, priced for longer-distance travel.`;
  } else if (fromLga === toLga) {
    fare = 450 + Math.floor(Math.random() * 250);
    note = `Local Abia route: ${fromStop} to ${toStop} in ${fromLga}.`;
  } else if (gap <= 2) {
    fare = 800 + Math.floor(Math.random() * 450);
    note = `Nearby route between ${fromLga} and ${toLga}.`;
  } else if (gap <= 6) {
    fare = 1200 + Math.floor(Math.random() * 700);
    note = `Regional route connecting ${fromLga} to ${toLga}.`;
  } else {
    fare = 1700 + Math.floor(Math.random() * 1100);
    note = `Long-distance Abia route from ${fromLga} to ${toLga}.`;
  }

  return { fare, note };
}

function showPrice() {
  const fromStop = fromStopSelect.value;
  const toStop = toStopSelect.value;
  const { fare, note } = estimateFare(fromStop, toStop);

  if (!fare) {
    priceOutput.textContent = note;
    return;
  }

  priceOutput.innerHTML = `
    <div class="fare-card reveal-card">
      <span class="fare-label">Estimated fare</span>
      <strong>₦${fare.toLocaleString()}</strong>
      <p>${note}</p>
    </div>
  `;
}

function saveRoute() {
  const fromStop = fromStopSelect.value;
  const toStop = toStopSelect.value;
  const { fare, note } = estimateFare(fromStop, toStop);

  if (!fare) {
    setAuthMessage(note, true);
    return;
  }

  const history = getRouteHistory();
  const newEntry = {
    from: fromStop,
    to: toStop,
    fare,
    note,
    savedAt: new Date().toISOString()
  };

  const updated = [newEntry, ...history].slice(0, 10);
  saveRouteHistory(updated);
  renderHistory();
  setAuthMessage("Route saved successfully.");
}

function swapStops() {
  const currentFrom = fromStopSelect.value;
  fromStopSelect.value = toStopSelect.value;
  toStopSelect.value = currentFrom;
  showPrice();
}

function handleLogin(event) {
  event.preventDefault();

  const name = document.getElementById("fullName").value.trim();
  const phone = document.getElementById("phoneNumber").value.trim();
  const password = document.getElementById("password").value.trim();

  if (!name || !phone || !password) {
    setAuthMessage("Please fill in your name, phone number, and password.", true);
    return;
  }

  const user = {
    name,
    phone,
    password,
    loginTime: new Date().toISOString()
  };

  localStorage.setItem(STORAGE_KEY, JSON.stringify(user));
  setAuthMessage(
    navigator.onLine
      ? "Online login saved and ready for sync."
      : "Offline login saved. You can continue using the app without internet."
  );

  renderAuthState();
  signInForm.reset();
}

function handleLogout() {
  localStorage.removeItem(STORAGE_KEY);
  setAuthMessage("Signed out successfully.");
  renderAuthState();
}

function setMode(mode) {
  state.mode = mode;
  modeButtons.forEach((button) => {
    const isActive = button.dataset.mode === mode;
    button.classList.toggle("active", isActive);
  });
  showPrice();
}

function applyTheme(theme) {
  const isDark = theme === "dark";
  document.body.classList.toggle("dark-mode", isDark);
  themeToggle.textContent = isDark ? "☀️" : "🌙";
  localStorage.setItem(THEME_KEY, theme);
}

function initTheme() {
  const saved = localStorage.getItem(THEME_KEY) || "dark";
  state.theme = saved;
  applyTheme(saved);
}

function getIgboVoice() {
  const voices = window.speechSynthesis?.getVoices?.() || [];

  const preferred = voices.find((voice) => {
    const name = voice.name.toLowerCase();
    const lang = (voice.lang || "").toLowerCase();
    return lang.startsWith("ig") || name.includes("igbo") || name.includes("nigeria");
  });

  return preferred || voices[0] || null;
}

function speakIgboRoute(message) {
  if (!("speechSynthesis" in window)) {
    voiceStatus.textContent = "Voice not supported on this browser.";
    return;
  }

  const voice = getIgboVoice();
  const utterance = new SpeechSynthesisUtterance(message);
  if (voice) {
    utterance.voice = voice;
  }

  utterance.lang = "ig-NG";
  utterance.rate = 0.94;
  utterance.pitch = 1.08;
  utterance.volume = 1;

  speechSynthesis.cancel();
  speechSynthesis.speak(utterance);
  voiceStatus.textContent = voice ? `Using voice: ${voice.name}` : "Using default system voice";
}

function announceCurrentRoute() {
  const fromStop = fromStopSelect.value;
  const toStop = toStopSelect.value;
  const { fare, note } = estimateFare(fromStop, toStop);

  if (!fare) {
    speakIgboRoute("Biko họrọ ebe ọ na-aga wee banye ebe a na-aga.");
    return;
  }

  const igboText = `Ebe i na-esi: ${fromStop}. Ebe i na-aga: ${toStop}. Ego i ga-akwụ bụ nke naira ${fare.toLocaleString()}.`;
  speakIgboRoute(igboText);
}

window.addEventListener("online", () => {
  updateConnectionStatus();
  renderAuthState();
});

window.addEventListener("offline", () => {
  updateConnectionStatus();
  renderAuthState();
});

fromStopSelect.addEventListener("change", showPrice);
toStopSelect.addEventListener("change", showPrice);
document.getElementById("showPriceBtn").addEventListener("click", showPrice);
document.getElementById("saveRouteBtn").addEventListener("click", saveRoute);
document.getElementById("swapStops").addEventListener("click", swapStops);
logoutBtn.addEventListener("click", handleLogout);
signInForm.addEventListener("submit", handleLogin);
lgaSearchInput.addEventListener("input", (event) => renderLgaStops(event.target.value));
modeButtons.forEach((button) => {
  button.addEventListener("click", () => setMode(button.dataset.mode));
});

themeToggle.addEventListener("click", () => {
  const nextTheme = state.theme === "dark" ? "light" : "dark";
  state.theme = nextTheme;
  applyTheme(nextTheme);
});

playIgboVoiceBtn.addEventListener("click", announceCurrentRoute);

populateStops();
renderPopularRoutes();
renderLgaStops();
renderHistory();
updateConnectionStatus();
renderAuthState();
initTheme();
showPrice();

if ("speechSynthesis" in window) {
  speechSynthesis.onvoiceschanged = () => {
    const voice = getIgboVoice();
    if (voice) {
      voiceStatus.textContent = `Igbo voice detected: ${voice.name}`;
    } else {
      voiceStatus.textContent = "No Igbo voice detected. Using default system voice.";
    }
  };
} else {
  voiceStatus.textContent = "Voice not supported on this browser.";
}

if ("serviceWorker" in navigator) {
  window.addEventListener("load", () => {
    navigator.serviceWorker.register("./sw.js").catch((error) => {
      console.warn("Service worker registration failed:", error);
    });
  });
}
EOF

